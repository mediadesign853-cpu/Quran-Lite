{
  "name": "quran-reader",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "prepare:electron": "node scripts/build-electron-updater.cjs && node scripts/prepare-electron.mjs",
    "electron:dev": "npm run build && npm run prepare:electron && electron .",
    "dist:win": "npm run build && npm run prepare:electron && npm run verify:portable-key && electron-builder --config electron-builder.yml --win",
    "verify:data": "node scripts/verify-data.mjs",
    "check": "npm run verify:data && npm run typecheck && npm run lint && npm run build",
    "generate:portable-keys": "node scripts/generate-portable-update-keys.cjs",
    "verify:portable-key": "node scripts/verify-portable-update-key.cjs",
    "create:portable-manifest": "node scripts/create-portable-update-manifest.cjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "lucide-react": "^1.70.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.12",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "esbuild": "^0.21.5"
  },
  "description": "Quran Reader Lite: Arabic Quran text, offline reading and search for Windows desktop.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mediadesign853-cpu/quran-lite.git"
  },
  "main": "electron/main.cjs",
  "author": "Quran Reader"
}
